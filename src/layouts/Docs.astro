---
interface SidebarLink {
  label: string;
  href: string;
}

interface SidebarGroup {
  title: string;
  links: SidebarLink[];
}

interface TocItem {
  label: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  lang: string;
  langColor?: string;
  type: string;
  version: string;
  sidebar: SidebarGroup[];
  toc: TocItem[];
}

const {
  title,
  description,
  lang,
  langColor = 'var(--color-cyan)',
  type,
  version,
  sidebar,
  toc,
} = Astro.props;

import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import BgBlobs from '../components/BgBlobs.astro';
import CustomCursor from '../components/CustomCursor.astro';
import SEO from '../components/SEO.astro';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <SEO title={`${title} docs`} description={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Syne:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <BgBlobs />
    <CustomCursor />
    <Navbar />

    <div class="docs-wrap">
      <!-- Header -->
      <header class="docs-header">
        <div class="docs-badges">
          <span class="doc-badge" style={`color:${langColor};background:${langColor}15;border-color:${langColor}33`}>{lang}</span>
          <span class="doc-badge badge-violet">{type}</span>
          <span class="doc-badge badge-outline">{version}</span>
        </div>
        <h1 class="docs-title">
          {title.split('').map((char, i) => {
            const halfway = Math.floor(title.length / 2);
            return i >= halfway ? (
              <span class="title-cyan">{char}</span>
            ) : (
              char
            );
          })}
        </h1>
        <p class="docs-desc">{description}</p>
        <div class="docs-ctas">
          <a href="#instalacion" class="btn-primary">instalación rápida →</a>
          <a href={`https://github.com/jee4nc/${title}`} class="btn-ghost" target="_blank" rel="noopener noreferrer">ver en github</a>
        </div>
      </header>

      <div class="h-px bg-border"></div>

      <!-- Content area with sidebar -->
      <div class="docs-layout">
        <!-- Sidebar -->
        <aside class="docs-sidebar">
          {sidebar.map((group) => (
            <div class="sidebar-group">
              <div class="sidebar-title">{group.title}</div>
              {group.links.map((link) => (
                <a href={link.href} class="sidebar-link">{link.label}</a>
              ))}
            </div>
          ))}
        </aside>

        <!-- Main content -->
        <div class="docs-content">
          <!-- TOC -->
          <div class="toc-box">
            <div class="toc-title">En esta página</div>
            {toc.map((item, i) => (
              <a href={item.href} class:list={['toc-link', { 'toc-active': i === 0 }]}>
                {item.label}
              </a>
            ))}
          </div>

          <slot />
        </div>
      </div>
    </div>

    <Footer />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  .docs-wrap {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 32px;
  }

  /* ── Header ── */
  .docs-header {
    padding: 60px 0 48px;
  }
  .docs-badges {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
  }
  .doc-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 3px 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border: 1px solid;
  }
  .badge-violet {
    color: var(--color-violet);
    background: rgba(124, 92, 252, 0.12);
    border-color: rgba(124, 92, 252, 0.25);
  }
  .badge-outline {
    color: var(--color-muted);
    background: transparent;
    border-color: var(--color-border);
  }
  .docs-title {
    font-size: clamp(40px, 6vw, 64px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    margin-bottom: 16px;
  }
  .title-cyan {
    color: var(--color-cyan);
  }
  .docs-desc {
    font-size: 17px;
    color: var(--color-muted);
    line-height: 1.6;
    max-width: 600px;
    margin-bottom: 32px;
  }
  .docs-ctas {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  /* Buttons (same as index) */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 28px;
    background: var(--color-cyan);
    color: var(--color-bg);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-decoration: none;
    clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 10px 100%, 0 calc(100% - 10px));
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(0, 212, 255, 0.35);
  }
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 28px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.05em;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
  }
  .btn-ghost:hover {
    border-color: var(--color-cyan);
    color: var(--color-cyan);
  }

  /* ── Layout ── */
  .docs-layout {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 48px;
    padding: 48px 0 96px;
  }

  /* ── Sidebar ── */
  .docs-sidebar {
    position: sticky;
    top: 76px;
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .sidebar-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .sidebar-title {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-cyan);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .sidebar-link {
    font-size: 13px;
    color: var(--color-muted);
    text-decoration: none;
    padding: 4px 0 4px 12px;
    border-left: 2px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }
  .sidebar-link:hover {
    color: var(--color-text);
    border-left-color: var(--color-border);
  }

  /* ── TOC ── */
  .toc-box {
    background: var(--color-bg2);
    border: 1px solid var(--color-border);
    padding: 20px 24px;
    margin-bottom: 40px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .toc-title {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .toc-link {
    font-size: 13px;
    color: var(--color-muted);
    text-decoration: none;
    padding: 3px 0 3px 12px;
    border-left: 2px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }
  .toc-link:hover {
    color: var(--color-text);
  }
  .toc-active {
    color: var(--color-cyan);
    border-left-color: var(--color-cyan);
  }

  /* ── Docs content prose ── */
  .docs-content :global(h2) {
    font-size: 24px;
    font-weight: 700;
    margin-top: 48px;
    margin-bottom: 16px;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }
  .docs-content :global(h3) {
    font-size: 18px;
    font-weight: 700;
    margin-top: 32px;
    margin-bottom: 12px;
    color: var(--color-text);
  }
  .docs-content :global(p) {
    font-size: 15px;
    color: #94a3b8;
    line-height: 1.7;
    margin-bottom: 20px;
  }
  .docs-content :global(a) {
    color: var(--color-cyan);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .docs-content :global(strong) {
    color: var(--color-text);
  }
  .docs-content :global(code:not(pre code)) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--color-surface);
    color: var(--color-cyan);
    padding: 2px 6px;
    border-radius: 3px;
    border: 1px solid var(--color-border);
  }
  .docs-content :global(ul) {
    list-style-type: disc;
    margin-bottom: 20px;
    padding-left: 20px;
  }
  .docs-content :global(li) {
    font-size: 15px;
    color: #94a3b8;
    line-height: 1.7;
    margin-bottom: 6px;
  }
  .docs-content :global(li::marker) {
    color: var(--color-violet);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .docs-layout {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .docs-sidebar {
      position: static;
      flex-direction: row;
      overflow-x: auto;
      gap: 24px;
      padding-bottom: 24px;
      border-bottom: 1px solid var(--color-border);
      margin-bottom: 32px;
    }
    .sidebar-group {
      min-width: max-content;
    }
    .sidebar-link {
      border-left: none;
      padding-left: 0;
    }
  }
</style>
