---
import Base from '../../layouts/Base.astro';

const projects = [
  {
    num: '01',
    title: 'taghound',
    desc: 'Fetcher de Git tags multi-repositorio. Distribuido via Homebrew, Scoop y .deb. Pensado para equipos con muchos microservicios.',
    lang: 'Go',
    langColor: 'cyan',
    type: 'CLI',
    tags: ['GoReleaser', 'Homebrew', 'cross-platform', 'semver'],
    href: '/projects/taghound',
    repo: 'https://github.com/jee4nc/taghound',
  },
  {
    num: '02',
    title: 'packwatch',
    desc: 'TUI interactivo para gestionar actualizaciones de dependencias npm. Detecta vulnerabilidades, respeta tu versión de Node, y te deja elegir qué actualizar.',
    lang: 'Go',
    langColor: 'cyan',
    type: 'TUI',
    tags: ['goroutines', 'npm registry', 'bubbletea', 'security advisories'],
    href: '/projects/packwatch',
    repo: 'https://github.com/jee4nc/packwatch',
  },
  {
    num: '03',
    title: 'PrintSII',
    desc: 'App iOS para imprimir boletas electrónicas del SII en impresoras Epson TM-m30III via WiFi/AirPrint con detección de código de barras.',
    lang: 'Swift',
    langColor: 'orange',
    type: 'iOS',
    tags: ['PDFKit', 'Vision', 'AirPrint', 'Epson SDK'],
    href: null,
    repo: null,
  },
];
---

<Base title="Proyectos" description="CLIs, TUIs y apps que he construido.">
  <div class="mx-auto max-w-[1100px] px-8">

    <section class="pb-24 pt-20">
      <div class="section-head">
        <span class="section-label">proyectos</span>
        <h1 class="section-title">Lo que construyo</h1>
        <div class="section-line"></div>
      </div>

      <p class="section-desc">
        Herramientas CLI, apps nativas y webapps open source. Proyectos pensados para resolver problemas reales — desde flujos de desarrollo hasta productividad y comercio digital.
      </p>

      <div class="projects-list">
        {projects.map((project) => (
          <div class="project-card interactive">
            {project.href && (
              <a href={project.href} class="card-overlay" aria-label={`Ver ${project.title}`}></a>
            )}
            <div class="loading-bar"></div>
            <span class="project-num-bg">{project.num}</span>

            <div class="project-body">
              <div class="project-meta">
                <span class:list={['badge', `badge-${project.langColor}`]}>{project.lang}</span>
                <span class="badge badge-violet">{project.type}</span>
              </div>

              <div class="project-title">{project.title}</div>
              <p class="project-desc">{project.desc}</p>

              <div class="project-tags">
                {project.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </div>

            <div class="project-aside">
              <div class="project-links">
                {project.href && (
                  <span class="project-link">
                    ver docs →
                  </span>
                )}
                {project.repo && (
                  <a
                    href={project.repo}
                    class="project-link project-link-external"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    github ↗
                  </a>
                )}
                {!project.href && !project.repo && (
                  <span class="project-link project-link-muted">
                    repo privado
                  </span>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

  </div>
</Base>

<style>
  /* ── Section ── */
  .section-head {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
  }
  .section-label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-cyan);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .section-title {
    font-size: 32px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .section-line {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }
  .section-desc {
    font-size: 16px;
    color: var(--color-muted);
    line-height: 1.6;
    max-width: 520px;
    margin-bottom: 48px;
  }

  /* ── List ── */
  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* ── Card ── */
  .project-card {
    background: var(--color-bg2);
    border: 1px solid var(--color-border);
    padding: 36px 40px;
    position: relative;
    overflow: hidden;
    transition: border-color 0.2s, transform 0.2s;
    cursor: pointer;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
  }

  /* Overlay link — makes entire card clickable without nesting <a> */
  .card-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* External links sit above the overlay */
  .project-link-external {
    position: relative;
    z-index: 2;
  }
  .project-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(180deg, var(--color-cyan), var(--color-violet));
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.3s ease;
  }
  .project-card:hover {
    border-color: rgba(0, 212, 255, 0.3);
    transform: translateX(4px);
  }
  .project-card:hover::before {
    transform: scaleY(1);
  }

  /* ── Background number ── */
  .project-num-bg {
    position: absolute;
    top: -8px;
    right: 24px;
    font-family: var(--font-mono);
    font-size: 96px;
    font-weight: 700;
    color: rgba(0, 212, 255, 0.04);
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }

  /* ── Body ── */
  .project-body {
    min-width: 0;
  }

  .project-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }
  .badge {
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 3px 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border: 1px solid;
  }
  .badge-cyan {
    color: var(--color-cyan);
    background: var(--color-cyan-dim);
    border-color: rgba(0, 212, 255, 0.2);
  }
  .badge-violet {
    color: var(--color-violet);
    background: rgba(124, 92, 252, 0.12);
    border-color: rgba(124, 92, 252, 0.25);
  }
  .badge-orange {
    color: #f97316;
    background: rgba(249, 115, 22, 0.1);
    border-color: rgba(249, 115, 22, 0.2);
  }
  .project-title {
    font-size: 26px;
    font-weight: 700;
    margin-bottom: 10px;
    letter-spacing: -0.01em;
  }
  .project-desc {
    font-size: 14px;
    color: var(--color-muted);
    line-height: 1.7;
    margin-bottom: 20px;
    max-width: 560px;
  }
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tag {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    padding: 3px 10px;
    letter-spacing: 0.08em;
  }

  /* ── Aside (links) ── */
  .project-aside {
    display: flex;
    align-items: center;
    align-self: center;
    margin-left: 40px;
  }
  .project-links {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-left: 24px;
    border-left: 1px solid var(--color-border);
  }
  .project-link {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-cyan);
    text-decoration: none;
    letter-spacing: 0.05em;
    transition: color 0.2s;
    white-space: nowrap;
  }
  .project-link:hover {
    color: #5ce6ff;
  }
  .project-link-muted {
    color: var(--color-muted);
  }

  /* ── Loading state ── */
  .loading-bar {
    position: absolute;
    top: 0;
    left: 0;
    height: 3px;
    width: 0;
    background: linear-gradient(90deg, var(--color-cyan), var(--color-violet));
    z-index: 3;
    opacity: 0;
    transition: none;
  }
  .project-card.is-loading {
    pointer-events: none;
    border-color: rgba(0, 212, 255, 0.3);
  }
  .project-card.is-loading::before {
    transform: scaleY(1);
  }
  .project-card.is-loading .loading-bar {
    opacity: 1;
    animation: loading-progress 1.2s ease-in-out infinite;
  }
  .project-card.is-loading .project-body,
  .project-card.is-loading .project-aside {
    opacity: 0.5;
    transition: opacity 0.2s;
  }
  .project-card.is-loading .project-link:first-child::after {
    content: ' cargando...';
  }
  @keyframes loading-progress {
    0%   { left: 0; width: 0; }
    30%  { left: 0; width: 60%; }
    70%  { left: 40%; width: 60%; }
    100% { left: 100%; width: 0; }
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .project-card {
      grid-template-columns: 1fr;
      padding: 28px 24px;
    }
    .project-aside {
      margin-left: 0;
      margin-top: 20px;
    }
    .project-links {
      flex-direction: row;
      border-left: none;
      border-top: 1px solid var(--color-border);
      padding-left: 0;
      padding-top: 16px;
    }
    .project-num-bg {
      font-size: 64px;
      right: 16px;
    }
  }
</style>

<script>
  document.querySelectorAll('.card-overlay').forEach((overlay) => {
    overlay.addEventListener('click', (e) => {
      e.preventDefault();
      const card = overlay.closest('.project-card');
      const href = (overlay as HTMLAnchorElement).href;
      card?.classList.add('is-loading');
      // Show loading state for at least 400ms so user can see it
      setTimeout(() => {
        window.location.href = href;
      }, 400);
    });
  });

  // Reset loading state when navigating back (bfcache)
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) {
      document.querySelectorAll('.project-card.is-loading').forEach((card) => {
        card.classList.remove('is-loading');
      });
    }
  });
</script>
