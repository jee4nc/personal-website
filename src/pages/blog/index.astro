---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

function formatDate(date: Date) {
  return date.toLocaleDateString('es-CL', { year: 'numeric', month: 'short' });
}
---

<Base title="Blog" description="Artículos sobre desarrollo, devops e infraestructura.">
  <div class="mx-auto max-w-[1100px] px-8">

    <section class="pb-24 pt-20">
      <div class="section-head">
        <span class="section-label">blog</span>
        <h1 class="section-title">Artículos</h1>
        <div class="section-line"></div>
      </div>

      <div class="posts-list">
        {posts.map((post) => (
          <a href={`/blog/${post.id}`} class="post-item interactive">
            <span class="post-date">{formatDate(post.data.date)}</span>
            <div class="post-body">
              <span class="post-title">{post.data.title}</span>
              <span class="post-desc">{post.data.description}</span>
            </div>
            <div class="post-tags-group">
              {post.data.tags.map((tag) => (
                <span class="post-tag">{tag}</span>
              ))}
            </div>
            <span class="post-arrow">→</span>
          </a>
        ))}
      </div>
    </section>

  </div>
</Base>

<style>
  .section-head {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 56px;
  }
  .section-label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-cyan);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .section-title {
    font-size: 32px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .section-line {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
  }
  .post-item {
    background: var(--color-bg2);
    padding: 28px 32px;
    display: flex;
    align-items: center;
    gap: 32px;
    text-decoration: none;
    color: inherit;
    transition: background 0.15s;
  }
  .post-item:hover {
    background: var(--color-bg3);
  }
  .post-date {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-muted);
    min-width: 80px;
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }
  .post-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .post-title {
    font-size: 16px;
    font-weight: 600;
  }
  .post-desc {
    font-size: 13px;
    color: var(--color-muted);
    line-height: 1.5;
  }
  .post-tags-group {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }
  .post-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-cyan);
    background: var(--color-cyan-dim);
    padding: 2px 8px;
    border: 1px solid rgba(0, 212, 255, 0.15);
  }
  .post-arrow {
    color: var(--color-muted);
    font-size: 18px;
    transition: transform 0.2s, color 0.2s;
    flex-shrink: 0;
  }
  .post-item:hover .post-arrow {
    transform: translateX(4px);
    color: var(--color-cyan);
  }

  @media (max-width: 768px) {
    .post-item {
      flex-wrap: wrap;
      gap: 8px 16px;
      padding: 20px 24px;
    }
    .post-tags-group {
      order: 4;
      width: 100%;
    }
  }
</style>
